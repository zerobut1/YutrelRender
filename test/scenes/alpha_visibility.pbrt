Integrator "path" "integer maxdepth" [1]
Sampler "independent" "integer pixelsamples" [1]
PixelFilter "triangle"
Film "rgb" "string filename" ["alpha_visibility.exr"] "integer xresolution" [1] "integer yresolution" [1]
Camera "perspective"

WorldBegin
AttributeBegin
    Material "diffuse" "rgb reflectance" [1 0 0]
    Shape "trianglemesh"
        "point3 P" [-1 -1 -1  1 -1 -1  0 1 -1  1 -1 -1  3 -1 -1  2 1 -1]
        "integer indices" [0 1 2  3 4 5]
        "float alpha" [0]
AttributeEnd
AttributeBegin
    Material "diffuse" "rgb reflectance" [0 1 0]
    Shape "trianglemesh"
        "point3 P" [-1 -1 -2  1 -1 -2  0 1 -2]
        "integer indices" [0 1 2]
AttributeEnd
