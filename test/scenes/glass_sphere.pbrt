Integrator "path"
    "integer maxdepth" [10]
Sampler "independent"
    "integer pixelsamples" [4096]
Film "rgb"
    "integer xresolution" [32]
    "integer yresolution" [32]
    "string filename" "glass_sphere.exr"
Camera "perspective"
    "float fov" [60]

WorldBegin

# Dispersive glass sphere
MakeNamedMaterial "Glass"
    "string type" [ "dielectric" ]
    "spectrum eta" [ "glass-F11" ]
    "float roughness" [ 0 ]

# White diffuse floor
Material "diffuse"
    "rgb reflectance" [1 1 1]
Shape "trianglemesh"
    "point3 P" [-10 -10 -1  10 -10 -1  10 10 -1  -10 10 -1]
    "integer indices" [0 1 2  0 2 3]

# Glass sphere (using PLY or trianglemesh with sphere approximation)
AttributeBegin
    NamedMaterial "Glass"
    Shape "sphere"
        "float radius" [1]
AttributeEnd

# White area light above
AttributeBegin
    Translate 0 0 5
    AreaLightSource "diffuse"
        "rgb L" [10 10 10]
    Material "diffuse"
        "rgb reflectance" [0 0 0]
    Shape "trianglemesh"
        "point3 P" [-2 -2 0  2 -2 0  2 2 0  -2 2 0]
        "integer indices" [0 2 1  0 3 2]
AttributeEnd
